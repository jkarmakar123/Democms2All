@model ResourcePage
@using EPiServer.Web.Mvc.Html

<div class="article-card">

    <a href="@Url.ContentUrl(Model.ContentLink)">

        @if (Model.ThumbnailImage != null)
        {
            <img src="@Url.ContentUrl(Model.ThumbnailImage)" 
                 alt="@Model.ResourceTitle" class="article-thumb" />
        }

        <div class="article-content">

            <h3>@Model.ResourceTitle</h3>

            <p>@Model.Description</p>

            <div class="meta">
                <span>@Model.ResourceCategory</span>
                @* <span>@Model.ResourceAuthor</span> *@
                <span>@Model.PublishedDate.ToString("dd MMM yyyy")</span>
                @* <span>@Model.ReadTimeMinutes min read</span> *@
            </div>

            <span class="read-more">Read More →</span>

        </div>

    </a>

</div>