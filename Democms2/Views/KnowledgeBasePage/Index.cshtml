@{
    string BuildQueryString(int page, string? tag, string? category)
    {
        var parts = new List<string> { $"page={page}" };
        
        @* if (!string.IsNullOrWhiteSpace(tag)) Uri.EscapeDataString(tag) *@
            parts.Add($"tag={tag}");
        
        @* if (!string.IsNullOrWhiteSpace(category)) *@
            parts.Add($"articleCategory={category}");
        
        return "?" + string.Join("&", parts);
    }
}

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            var queryString = BuildQueryString(i, Model.SelectedTag, Model.SelectedArticleCategory);
            var isCurrentPage = i == Model.CurrentPageNumber;
            
            <a href="@queryString" 
               class="pagination-link @(isCurrentPage ? "active" : "")">
                @i
            </a>
        }
    </div>
}



</section>
