@model Democms2.Models.Pages.ResourcePage

@using EPiServer.Core
@using EPiServer.Web.Mvc.Html

<article class="resource-page">

    <header class="resource-page__header">

        <span class="resource-page__category">
            @Html.PropertyFor(x => x.ResourceCategory)
        </span>

        <h1 class="resource-page__title">
            @Html.PropertyFor(x => x.ResourceTitle)
        </h1>

        <div class="resource-page__meta">

            <span>
                @Html.PropertyFor(x => x.PublishedDate)
            </span>

        </div>

    </header>

    @if (!ContentReference.IsNullOrEmpty(Model.ThumbnailImage))
    {
        <div class="resource-page__image">

            <img src="@Url.ContentUrl(Model.ThumbnailImage)"
                 alt="@Model.ResourceTitle" />

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="resource-page__summary">
            @Html.PropertyFor(x => x.Description)
        </div>
    }

    @if (!ContentReference.IsNullOrEmpty(Model.ResourceFile))
    {
        <div class="resource-page__download">

            <a href="@Url.ContentUrl(Model.ResourceFile)"
               class="btn btn-primary"
               download>
                Download Resource
            </a>

        </div>
    }

</article>